<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-paddle-ocr"
        version="1.0.0">

  <name>PaddleOCR</name>
  <description>On-device text recognition with PaddleOCR PP-OCRv5 mobile models and ONNX Runtime</description>
  <license>GPL-3.0-or-later (plugin code), Apache-2.0 (models)</license>

  <js-module src="www/paddle-ocr.js" name="PaddleOcr">
    <clobbers target="PaddleOcr" />
  </js-module>

  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="PaddleOcr">
        <param name="android-package" value="com.waistline.paddleocr.PaddleOcrPlugin" />
      </feature>
    </config-file>

    <!-- ONNX Runtime needs Android 7.0 (API 24), and CameraX and its dependencies Android 6.0
         (API 23). The app supports older versions, so the plugin only loads these classes on
         API 24+ and reports itself unavailable below. -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-sdk tools:overrideLibrary="ai.onnxruntime,androidx.camera.core,androidx.camera.camera2,androidx.camera.camera2.pipe,androidx.camera.lifecycle,androidx.camera.view,androidx.camera.video,androidx.camera.viewfinder.core,androidx.media3.muxer,androidx.media3.container,androidx.media3.common,androidx.core.backported.fixes,androidx.camera.featurecombinationquery" xmlns:tools="http://schemas.android.com/tools" />
    </config-file>

    <!-- Remove ONNX Runtime's telemetry initializer. For ML Kit: don't start it with the app (it's
         started when the ML Kit engine is first used), and remove the backend that uploads its
         usage logs to Google. -->
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <provider android:name="ai.onnxruntime.TelemetryInitializer"
                android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
                tools:node="remove" xmlns:tools="http://schemas.android.com/tools" />
      <provider android:name="com.google.mlkit.common.internal.MlKitInitProvider"
                android:authorities="${applicationId}.mlkitinitprovider"
                tools:node="remove" xmlns:tools="http://schemas.android.com/tools" />
      <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
               android:exported="false" xmlns:tools="http://schemas.android.com/tools">
        <meta-data android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                   tools:node="remove" />
      </service>
    </config-file>

    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
    </config-file>

    <framework src="com.microsoft.onnxruntime:onnxruntime-android:1.30.0" />
    <framework src="androidx.camera:camera-camera2:1.6.2" />
    <framework src="androidx.camera:camera-lifecycle:1.6.2" />
    <framework src="androidx.camera:camera-view:1.6.2" />
    <framework src="androidx.exifinterface:exifinterface:1.3.7" />
    <!-- Google ML Kit text recognition (bundled Latin model), the optional second engine -->
    <framework src="com.google.mlkit:text-recognition:16.0.1" />

    <source-file src="src/android/PaddleOcrPlugin.java" target-dir="src/com/waistline/paddleocr" />
    <source-file src="src/android/OcrEngine.java" target-dir="src/com/waistline/paddleocr" />
    <source-file src="src/android/LiveScanner.java" target-dir="src/com/waistline/paddleocr" />
    <source-file src="src/android/MlKitEngine.java" target-dir="src/com/waistline/paddleocr" />

    <resource-file src="models/PP-OCRv5_mobile_det.onnx" target="assets/paddleocr/det.onnx" />
    <resource-file src="models/latin_PP-OCRv5_mobile_rec.onnx" target="assets/paddleocr/rec.onnx" />
    <resource-file src="models/latin_PP-OCRv5_mobile_rec_dict.txt" target="assets/paddleocr/rec_dict.txt" />
  </platform>
</plugin>
